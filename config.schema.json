{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dimbo1324/daily-quest/config.schema.json",
  "title": "Daily Quest configuration",
  "description": "GENERATED by scripts/build-schema.mjs from src/ — do not edit. Every key is optional; missing keys fall back to the built-in defaults.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA time zone, e.g. Europe/Berlin"
    },
    "startDate": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
      "description": "First calendar day (YYYY-MM-DD). Empty: the day of the first build."
    },
    "endDate": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
      "description": "Last calendar day (YYYY-MM-DD, needs startDate, at most 1100 days). Empty: startDate or today + daysToCreate."
    },
    "daysToCreate": {
      "type": "integer",
      "minimum": 7,
      "maximum": 400,
      "description": "Calendar length when endDate is empty."
    },
    "xpPerLevel": {
      "type": "number",
      "minimum": 1,
      "maximum": 1000000
    },
    "coinsPerXp": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "streakThreshold": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1,
      "description": "Share of the day's habits that keeps a streak."
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true
    },
    "habits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "xp",
          "days"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "xp": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "days": {
            "enum": [
              "all",
              "monsat",
              "monfri",
              "sat",
              "sun"
            ],
            "description": "Days of the week the habit is active."
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 30,
      "description": "Day-tracked rules: things to keep or to avoid. A tick means the rule was kept that day.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "xp",
          "kind",
          "days"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "xp": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "kind": {
            "enum": [
              "keep",
              "avoid"
            ],
            "description": "keep: a healthy rule to follow; avoid: something to stay away from."
          },
          "days": {
            "enum": [
              "all",
              "monsat",
              "monfri",
              "sat",
              "sun"
            ],
            "description": "Days of the week the rule is active."
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "category",
          "priority",
          "xp"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "description": "One of categories."
          },
          "deadline": {
            "type": "string",
            "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
            "description": "YYYY-MM-DD, or empty"
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "xp": {
            "type": "number",
            "minimum": 0,
            "maximum": 500
          }
        }
      }
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "strings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app.title": {
          "type": "string",
          "minLength": 1,
          "default": "🎮 Daily Quest"
