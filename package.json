{
  "name": "daily-quest",
  "version": "2.7.0",
  "private": true,
  "description": "Gamified habit & task tracker for Google Sheets (Apps Script)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run lint && npm run test && npm run check:config && npm run check:schema && npm run check:agents && npm run check:language",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:config": "node scripts/check-config.mjs",
    "check:schema": "node scripts/build-schema.mjs --check",
    "check:agents": "node scripts/sync-agents.mjs --check",
    "check:language": "node scripts/check-language.mjs",
    "schema": "node scripts/build-schema.mjs",
    "sync-agents": "node scripts/sync-agents.mjs",
    "login": "clasp login",
    "push": "clasp push",
    "pull": "clasp pull",
    "open": "clasp open-script",
    "deploy": "npm run check && clasp push",
    "format": "prettier --write \"**/*.{js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@google/clasp": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10"
  }
}
