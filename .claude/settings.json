{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run schema:*)",
      "Bash(npm run sync-agents:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(node --test:*)",
      "Bash(node scripts/check-config.mjs:*)",
      "Bash(node scripts/check-language.mjs:*)",
      "Bash(node scripts/build-schema.mjs:*)",
      "Bash(node scripts/sync-agents.mjs:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -*f*)",
      "Bash(git clean * -*f*)",
      "Bash(git checkout -- .*)",
      "Bash(git restore .*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf .ai*)",
      "Bash(rm -rf src*)",
      "Bash(rm -rf docs*)",
      "Bash(npm publish*)",
      "Read(./.clasp.json)",
      "Read(./.clasprc.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
